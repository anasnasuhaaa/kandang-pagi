# Use a dedicated development database in .env.local.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
IMAGEKIT_PRIVATE_KEY=
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=

# CLI target must be development for .env.local. Tests use a separate local *_test database.
DATABASE_TARGET=development
TEST_DATABASE_URL=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=

# Optional private ImageKit folder, use distinct prefixes in development and production.
IMAGEKIT_RECEIPT_FOLDER=

# Optional Docker local-db profile. Set these only in .env.postgres.local.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
